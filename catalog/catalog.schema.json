{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-kicad-toolkit/catalog.schema.json",
  "title": "Codex KiCad Toolkit catalog",
  "description": "Portable inventory of MCP servers and Codex skills used by the toolkit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "project",
    "purpose",
    "updated",
    "pathNote",
    "codexRegistration",
    "mcps",
    "skills"
  ],
  "properties": {
    "$schema": { "type": "string" },
  "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date" },
    "pathNote": { "type": "string", "minLength": 1 },
    "codexRegistration": { "$ref": "#/$defs/registration" },
    "mcps": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcp" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["registered", "direct-verified", "available", "installed", "needs-review", "planned"]
    },
    "verificationResult": {
      "type": "string",
      "enum": ["pass", "partial", "not-registered", "not-run", "fail"]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "network", "subprocess"],
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "network": { "type": "boolean" },
        "subprocess": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastChecked", "result", "commands", "observed"],
      "properties": {
        "lastChecked": { "type": "string", "format": "date" },
        "result": { "$ref": "#/$defs/verificationResult" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed": { "type": "string", "minLength": 1 }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "status", "lastChecked", "listedServers", "expectedServers", "note"],
      "properties": {
        "config": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["registered", "needs-review", "not-configured"] },
        "lastChecked": { "type": "string", "format": "date" },
        "listedServers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "expectedServers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "purpose", "source", "status", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "upstream": { "type": ["string", "null", "object"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "config": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "enum": ["stdio", "http", "unknown"] },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "environment": {
          "type": "array",
          "items": { "type": "string", "pattern": "^KICAD_[A-Z_]+$" }
        },
        "scope": { "type": "string", "minLength": 1 },
        "permissions": { "$ref": "#/$defs/permissions" },
        "risk": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "status": { "$ref": "#/$defs/status" },
        "verification": { "$ref": "#/$defs/verification" },
        "notes": { "type": "string" }
      }
    },
    "mcp": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        {
          "required": ["entrypoint", "config", "transport", "capabilities", "permissions", "risk"]
        }
      ]
    },
    "skill": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        {
          "required": ["scope"]
        }
      ]
    }
  }
}
